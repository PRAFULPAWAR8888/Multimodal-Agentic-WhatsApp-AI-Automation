# Application
APP_NAME=WhatsApp AI Platform
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-32-char-secret
ALLOWED_ORIGINS='["http://localhost:5173","http://localhost:3000"]'

# Database
DATABASE_URL=postgresql+asyncpg://whatsapp_agent:password@localhost:5432/whatsapp_agent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI (Primary LLM Provider)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.1

# LLM Provider (openai | ollama | huggingface)
LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# =========================
# LLM GOVERNANCE / LIMITS
# =========================
LLM_MAX_INPUT_WORDS=500
LLM_MAX_INPUT_TOKENS=4000

LLM_CONTEXT_MAX_WORDS=1500
LLM_CONTEXT_MAX_TOKENS=6000

LLM_SHORT_MAX_OUTPUT_TOKENS=80
LLM_NORMAL_MAX_OUTPUT_TOKENS=200
LLM_DETAILED_MAX_OUTPUT_TOKENS=500

LLM_MAX_TOKENS_PER_REQUEST=7000
LLM_MAX_TOKENS_PER_SESSION=30000
LLM_MAX_TOKENS_PER_DAY=100000

LLM_OVERSIZE_ACTION=reject
LLM_CONTEXT_OVERFLOW_ACTION=truncate

LLM_ENABLE_INPUT_LIMIT=true
LLM_ENABLE_CONTEXT_LIMIT=true
LLM_ENABLE_OUTPUT_LIMIT=true
LLM_ENABLE_SESSION_BUDGET=true
LLM_ENABLE_COST_ESTIMATION=true
LLM_ENABLE_USAGE_LOGGING=true

# Embeddings
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Speech-to-Text (openai_whisper | faster_whisper)
STT_PROVIDER=faster_whisper
FASTER_WHISPER_MODEL=base
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8

# Text-to-Speech (piper | openai_tts | gtts)
TTS_PROVIDER=piper
PIPER_MODEL_PATH=./models/piper/en_US-lessac-medium.onnx

# Vision
VISION_PROVIDER=moondream
MOONDREAM_MODEL=vikhyatk/moondream2

# WhatsApp
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# CRM
CRM_PROVIDER=mock
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8000/api/v1/crm/hubspot/callback

# Calendar
CALENDAR_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/google/callback

# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./media

# Security
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Media
MAX_FILE_SIZE_MB=16
ALLOWED_IMAGE_TYPES='["image/jpeg","image/png","image/webp"]'
ALLOWED_AUDIO_TYPES='["audio/ogg","audio/mp3","audio/mpeg","audio/aac","audio/amr"]'
ALLOWED_DOCUMENT_TYPES='["application/pdf","application/msword","text/plain","text/csv"]'

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
